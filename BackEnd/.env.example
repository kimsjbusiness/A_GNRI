# =========================================================================
# A-GNRI Backend Environment Variables Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit the '.env' file to version control.
# =========================================================================

# Third-party News & LLM API Keys
NEWS_API_KEY=your_news_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace / Stability AI Image Generation Config
SDXL_API_URL=https://api-inference.huggingface.co/models/stabilityai/sdxl-turbo
SDXL_API_KEY=your_sdxl_api_key_here

# PostgreSQL Database Connection URLs
# Format: postgresql+asyncpg://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql+asyncpg://admin_ksj:your_password_here@localhost:25725/admin_ksj
DB_URL=postgresql://admin_ksj:your_password_here@localhost:25725/admin_ksj
